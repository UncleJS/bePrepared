# -----------------------------------------------------------------------
# bePrepared — environment variables
# Canonical operator file. Copy to .env and fill in real values before use.
#   cp .env.example .env
# install.sh / update.sh / split-env.sh write per-service files from this
# one file: .env.db, .env.api, .env.worker, .env.frontend (do not edit those).
# NEVER commit .env or the generated .env.* files to version control.
# -----------------------------------------------------------------------

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=beprepared
DB_USER=bpuser
# Change this to a strong password
DB_PASSWORD=changeme
# MariaDB root password (used only by the db container)
DB_ROOT_PASSWORD=changeme-root

# MariaDB container variables (mirror values above)
MARIADB_DATABASE=beprepared
MARIADB_USER=bpuser
MARIADB_PASSWORD=changeme
MARIADB_ROOT_PASSWORD=changeme-root

# Drizzle / API connection string (must match above)
DATABASE_URL=mysql://bpuser:changeme@127.0.0.1:3306/beprepared

# --- API ---
# Internal container port (pod maps host:9996 → container:9995 in dev; prod publishes 9995 to host)
PORT=9995
NODE_ENV=production

# --- Authentication ---
# Generate with: openssl rand -base64 32
# Must be at least 32 characters. The placeholder below is rejected at startup.
AUTH_SECRET=replace-with-a-random-secret
# Optional explicit API signing secret (falls back to AUTH_SECRET if unset)
API_AUTH_SECRET=
# Enable API bearer-token protection
# Must remain true in production.
AUTH_ENABLED=true
# Login rate limit window (ms) and max attempts per window (per username).
# X-Forwarded-For is ignored unless TRUST_PROXY=true.
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=60000
AUTH_LOGIN_RATE_LIMIT_MAX=5
TRUST_PROXY=false
# Comma-separated CORS origins allowed to call API
# Dev: http://localhost:9997  |  Prod: http://localhost:9999
CORS_ORIGINS=http://localhost:9999
# The documented install is localhost, so this default lets the API start.
# A LAN or public origin must replace CORS_ORIGINS and set this back to false.
ALLOW_LOCALHOST_CORS_IN_PRODUCTION=true
# REQUIRED in production: set a strong admin seed password
SEED_ADMIN_PASSWORD=replace-with-strong-password

# --- Frontend ---
# URL the browser uses to reach the API (external / published).
# Must be set at Vite build time (baked into the JS bundle).
# Prod default: http://localhost:9995  |  Dev default: http://localhost:9996
VITE_API_URL=http://localhost:9995

# --- Worker ---
# Alert worker run interval in milliseconds (default: 900000 = 15 minutes).
# Keep at or below 21600000 (6 hours) so the Quadlet -mmin health window
# (2× interval, floor 30 minutes) stays practical.
WORKER_INTERVAL_MS=900000

# --- Ports (published to host) ---
# Dev:  frontend=9997, api=9996
# Prod: frontend=9999, api=9995
# Publish these ports only on localhost, or put TLS in front of them.
# This repo does not terminate TLS. A LAN or internet deployment needs an
# external reverse proxy (Caddy, nginx, or the host firewall) with HTTPS.
# FRONTEND_PORT is not consumed by any container — kept here for operator reference only.
# FRONTEND_PORT=9997
